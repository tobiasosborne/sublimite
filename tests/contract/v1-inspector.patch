diff --git a/src/editor/inspect.c b/src/editor/inspect.c
new file mode 100644
index 0000000000000000000000000000000000000000..4bae19f6a783859778aae978d08675dced405e37
--- /dev/null
+++ b/src/editor/inspect.c
@@ -0,0 +1,301 @@
+/* Linux X11 oracle adapter. Field order and values: W0.6c wire revision 1. */
+#if !defined(_WIN32)
+#include "editor/private.h"
+#include <endian.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include <xcb/xcb.h>
+
+enum { REVISION = 1, SNAP = 1, NEXT = 2 };
+enum result { OK = 0, VERSION = 2, ORDER = 3, SIZE = 4, INVALID = 5 };
+enum ticket_state { IDLE, WAIT_PAINT, WAIT_NATURAL, WAIT_SUBMIT };
+
+struct editor_inspector {
+    uint8_t *mapping;
+    size_t capacity, allocations, scopes;
+    int fd; /* negative after disconnect */
+    uint32_t atom, ticket;
+    enum ticket_state state;
+    bool measuring;
+};
+
+static int descriptor(const char *arg, char **end)
+{
+    if (*arg < '0' || *arg > '9') return -1;
+    long value = strtol(arg, end, 10);
+    return value > STDERR_FILENO && value <= INT_MAX ? (int)value : -1;
+}
+
+static bool socketpair_end(int fd)
+{
+    struct sockaddr_un addr;
+    struct ucred peer;
+    int flags = fcntl(fd, F_GETFL), type;
+    socklen_t len = sizeof type;
+    if (flags < 0 || !(flags & O_NONBLOCK) ||
+        getsockopt(fd, SOL_SOCKET, SO_TYPE, &type, &len) || type != SOCK_SEQPACKET) return false;
+    len = sizeof addr;
+    if (getsockname(fd, (struct sockaddr *)&addr, &len) || addr.sun_family != AF_UNIX ||
+        len != offsetof(struct sockaddr_un, sun_path)) return false;
+    len = sizeof addr;
+    if (getpeername(fd, (struct sockaddr *)&addr, &len) ||
+        len != offsetof(struct sockaddr_un, sun_path)) return false;
+    len = sizeof peer;
+    return !getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &peer, &len) &&
+        len == sizeof peer && peer.pid == getppid() && peer.uid == getuid();
+}
+
+editor_inspector *editor_inspect_open(const char *arg)
+{
+    char *end;
+    int m = descriptor(arg, &end);
+    if (m < 0 || *end != ',') return NULL;
+    int s = descriptor(end + 1, &end);
+    if (s < 0 || *end || m == s || !socketpair_end(s)) return NULL;
+    int seals = fcntl(m, F_GET_SEALS);
+    const int required = F_SEAL_GROW | F_SEAL_SHRINK;
+    struct stat info;
+    char link[sizeof "/proc/self/fd/" + sizeof(int) * CHAR_BIT], name[sizeof "/memfd:" - 1u];
+    (void)snprintf(link, sizeof link, "/proc/self/fd/%d", m);
+    if (seals < 0 || (seals & required) != required ||
+        readlink(link, name, sizeof name) != (ssize_t)sizeof name || memcmp(name, "/memfd:", sizeof name) ||
+        fstat(m, &info) || info.st_size <= 0 || (uintmax_t)info.st_size > UINT32_MAX ||
+        fcntl(m, F_SETFD, FD_CLOEXEC) || fcntl(s, F_SETFD, FD_CLOEXEC)) return NULL;
+    editor_inspector *in = calloc(1, sizeof *in);
+    if (!in) return NULL;
+    in->fd = s;
+    in->capacity = (size_t)info.st_size;
+    /* The writable mapping also checks access mode and write seals. */
+    in->mapping = mmap(NULL, in->capacity, PROT_READ | PROT_WRITE, MAP_SHARED, m, 0);
+    close(m);
+    if (in->mapping == MAP_FAILED) { free(in); return NULL; }
+    memset(in->mapping, 0, in->capacity); /* prefault before input */
+    return in;
+}
+
+static void disconnect(editor_inspector *in)
+{
+    if (in->fd >= 0) close(in->fd);
+    in->fd = -1;
+    in->state = IDLE;
+}
+
+void editor_inspect_end_scope(editor_inspector *in)
+{
+    if (!in->measuring) return;
+    in->allocations += edit_malloc_guard_end_thread();
+    in->measuring = false;
+}
+
+void editor_inspect_close(editor_inspector *in)
+{
+    editor_inspect_end_scope(in);
+    fprintf(stderr, "oracle law2: active=%d allocations=%zu scopes=%zu\n",
+            edit_malloc_guard_active(), in->allocations, in->scopes);
+    disconnect(in);
+    munmap(in->mapping, in->capacity);
+    free(in);
+}
+
+typedef struct writer {
+    uint8_t *bytes;
+    size_t capacity, used;
+    bool failed;
+} writer;
+
+static void bytes(writer *w, const void *value, size_t n)
+{
+    if (n > w->capacity - w->used) { w->failed = true; return; }
+    memcpy(w->bytes + w->used, value, n);
+    w->used += n;
+}
+
+static void words(writer *w, const uint32_t *values, size_t n)
+{
+    for (size_t i = 0; i < n && !w->failed; i++) {
+        uint32_t le = htole32(values[i]);
+        bytes(w, &le, sizeof le);
+    }
+}
+#define PUT(w, ...) words((w), (const uint32_t[]){__VA_ARGS__}, \
+                          sizeof((const uint32_t[]){__VA_ARGS__}) / sizeof(uint32_t))
+
+static void reply(editor *e, uint32_t ticket, enum result result, uint32_t size)
+{
+    editor_inspector *in = e->inspector;
+    uint8_t packet[sizeof "SCEL" - 1u + 5u * sizeof(uint32_t)] = "SCEL";
+    writer w = {.bytes = packet, .capacity = sizeof packet, .used = sizeof "SCEL" - 1u};
+    PUT(&w, REVISION, ticket, result, e->active_frame.id, size);
+    if (send(in->fd, packet, sizeof packet, MSG_DONTWAIT | MSG_NOSIGNAL) != sizeof packet)
+        disconnect(in);
+}
+
+bool editor_inspect_marker(void *ctx, uint32_t atom, const uint32_t *request)
+{
+    editor *e = ctx;
+    editor_inspector *in = e->inspector;
+    if (atom != in->atom) return false;
+    if (in->fd < 0) return true;
+    uint8_t byte;
+    /* The request channel is X11. EOF or data on the output socket retires it. */
+    if (!request || recv(in->fd, &byte, sizeof byte, MSG_PEEK | MSG_DONTWAIT) >= 0 || errno != EAGAIN) {
+        disconnect(in); return true;
+    }
+    e->pump_stopped = true;
+    plat_quit(&e->platform); /* ordered after preceding input delivery */
+    uint32_t rev = request[0], op = request[1], ticket = request[2], previous = request[3];
+    if (!ticket) reply(e, ticket, INVALID, 0);
+    else if (ticket <= in->ticket || in->state != IDLE) reply(e, ticket, ORDER, 0);
+    else {
+        in->ticket = ticket;
+        if (rev != REVISION) reply(e, ticket, VERSION, 0);
+        else if (request[4] || (op != SNAP && op != NEXT) || (op == SNAP && previous))
+            reply(e, ticket, INVALID, 0);
+        else if (previous > e->active_frame.id) reply(e, ticket, ORDER, 0);
+        else in->state = op == NEXT && previous == e->active_frame.id ? WAIT_NATURAL : WAIT_PAINT;
+    }
+    return true;
+}
+
+static bool prefix_done(const editor *e)
+{
+    return !e->queue_count && !e->op_count && !e->journal_metadata_pending &&
+        !e->journal_group_open && !e->explicit_group && !e->resize_pending &&
+        e->file_command == KEYS_ACTION_NONE && e->action == EDITOR_ACTION_NONE &&
+        !e->find_replace_request && !e->find_replace_active && !e->find_select_pending &&
+        !e->wheel_pending && !editor_scroll_waiting(e) && !editor_clip_busy(e) &&
+        !view_busy(&e->v) && !layout_busy(&e->lay) && !e->buffer->pending_open &&
+        !e->buffer->placeholder;
+}
+
+bool editor_inspect_repaint(const editor *e)
+{
+    return e->inspector->state == WAIT_PAINT && !e->dirty && !e->backend->active && prefix_done(e);
+}
+
+void editor_inspect_force_repaint(editor *e)
+{
+    editor_inspector *in = e->inspector;
+    in->state = WAIT_SUBMIT;
+    if (editor_begin_frame(e) || render_mark_full(&e->grid)) disconnect(in);
+}
+
+static void write_cells(writer *w, const editor *e, uint32_t count)
+{
+    const render_grid *g = &e->grid;
+    uint32_t color_origin = g->cells[0].bg; /* frame-local equality classes */
+    PUT(w, count);
+    for (uint32_t i = 0; i < count && !w->failed; i++) {
+        const render_cell *c = &g->cells[i];
+        bool right = (c->attrs & RENDER_ATTR_WIDE_RIGHT) != 0;
+        uint32_t cp = right ? 0 : font_async_artwork(e->fonts, g, c->atlas_slot);
+        enum { BLANK, TEXT, CONTINUATION, UNRESOLVED } kind =
+            right ? CONTINUATION : cp == UINT32_MAX ? UNRESOLVED : cp ? TEXT : BLANK;
+        uint32_t attrs = (c->attrs & RENDER_ATTR_CURSOR ? 1u : 0u) |
+            (c->attrs & RENDER_ATTR_UNDERLINE ? 2u : 0u) |
+            (kind != BLANK && (c->attrs & RENDER_ATTR_WIDE_LEFT) ? 4u : 0u);
+        bool inverse = (c->attrs & RENDER_ATTR_INVERSE) != 0;
+        uint8_t utf8[4]; /* utf8_encode's maximum bytes per scalar */
+        size_t len = kind == TEXT ? utf8_encode(cp, utf8) : 0;
+        PUT(w, kind, attrs, (inverse ? c->bg : c->fg) ^ color_origin,
+            (inverse ? c->fg : c->bg) ^ color_origin, (uint32_t)len);
+        bytes(w, utf8, len);
+    }
+}
+
+static void write_tabs(writer *w, const editor *e)
+{
+    const tabs_strip *s = &e->strip;
+    size_t available = tabs_count(&e->tabs);
+    /* The open menu's dropdown spans the entire tab row. */
+    if (e->tab_rows <= e->menu_rows || e->menu.open >= 0 || !s->col_count) {
+        PUT(w, 0); return;
+    }
+    available -= s->first_tab;
+    uint32_t count = (s->col_count - 1u) / s->tab_cols + 1u; /* ceiling */
+    if (count > available) count = (uint32_t)available;
+    size_t active = tabs_active_index(&e->tabs);
+    PUT(w, count);
+    for (uint32_t i = 0; i < count; i++) {
+        uint32_t offset = i * s->tab_cols, width = s->col_count - offset;
+        if (width > s->tab_cols) width = s->tab_cols;
+        PUT(w, s->first_col + offset, e->menu_rows, width, 1, active == s->first_tab + i);
+    }
+}
+
+static void snapshot(editor *e)
+{
+    editor_inspector *in = e->inspector;
+    const render_dims d = e->grid.dims;
+    const render_scroll s = e->grid.scroll;
+    uint32_t extra = s.origin_y_q8 != 0, gutter = e->lay.gw;
+    writer w = {.bytes = in->mapping, .capacity = in->capacity};
+    PUT(&w, 1, 0, e->active_frame.id, e->font.window_width, e->font.window_height,
+        d.cols, d.rows, d.cell_w, d.cell_h, gutter, e->tab_rows, e->text_grid.dims.cols - gutter,
+        e->v.config.rows, (uint32_t)s.origin_y_q8, 0, s.first_row, s.cols, s.rows, extra, 1u | 2u | 4u);
+    /* v1 bounds each grid axis at open/resize. Submit validated the backing storage. */
+    write_cells(&w, e, d.cols * (d.rows + extra));
+    write_tabs(&w, e);
+    PUT(&w, 0, d.rows - 1u, d.cols, 1);
+    reply(e, in->ticket, w.failed ? SIZE : OK, w.failed ? 0 : (uint32_t)w.used);
+}
+
+static void on_ingress(void *ctx, uint64_t sequence, uint64_t ns)
+{
+    (void)sequence; (void)ns;
+    editor_inspector *in = ((editor *)ctx)->inspector;
+    if (!in->measuring) {
+        in->measuring = true;
+        edit_malloc_guard_begin_thread();
+    }
+}
+
+static void on_io(void *ctx, bool entering)
+{
+    (void)ctx;
+    if (entering) edit_malloc_guard_exempt_begin();
+    else edit_malloc_guard_exempt_end();
+}
+
+static void on_submit(void *ctx, const editor_frame *frame)
+{
+    editor *e = ctx;
+    editor_inspector *in = e->inspector;
+    if (in->state != IDLE && prefix_done(e)) {
+        in->state = IDLE;
+        snapshot(e);
+    } else if (in->state == WAIT_NATURAL) {
+        in->state = WAIT_PAINT; /* the lower bound passed while input still drained */
+    }
+    if (frame->last_sequence && in->measuring) {
+        editor_inspect_end_scope(in);
+        in->scopes++;
+    }
+}
+
+int editor_inspect_attach(editor *e, editor_inspector *in)
+{
+    static const char name[] = "_SUBLIMITE_CONTRACT";
+    xcb_connection_t *c = plat_native_x11(&e->platform).connection;
+    xcb_intern_atom_reply_t *r = xcb_intern_atom_reply(c,
+        xcb_intern_atom(c, 0, sizeof name - 1u, name), NULL);
+    if (!r) return EDITOR_ERR_IO;
+    in->atom = r->atom;
+    free(r);
+    e->inspector = in;
+    e->cfg.hook_ctx = e;
+    e->cfg.on_ingress = on_ingress;
+    e->cfg.on_io = on_io;
+    e->cfg.on_submit = on_submit;
+    return 0;
+}
+#endif
